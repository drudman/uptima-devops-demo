    <decisions>
        <description>Determine if the requested Quote discount is greater than 50%</description>
        <name>Check_discount_greater_than_50_percent</name>
        <label>Check discount greater than 50 percent</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_than_50_percent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Record_for_the_Record_ID.Outputs.XXFetchedQuoteRecord.Discount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_for_next_approval</targetReference>
            </connector>
            <label>Greater than 50 percent</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the Quote discount is greater than 25%, then execute this step</description>
        <name>If_Quote_discount_is_greater_than_25</name>
        <label>If Quote discount is greater than 25</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Discount_25</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Record_for_the_Record_ID.Outputs.XXFetchedQuoteRecord.Discount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>25.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_for_approval</targetReference>
            </connector>
            <label>Discount &gt; 25</label>
        </rules>
    </decisions>
    <description>Check Quote Discount requested and route for approval based on the level of discount requested</description>
